--- a/src/backend/utils/init/miscinit.c
+++ b/src/backend/utils/init/miscinit.c
@@ -76,6 +76,11 @@ static Latch LocalLatchData;
 
 bool		IgnoreSystemIndexes = false;
 
+/* ----------------------------------------------------------------
+ *				Ptrack functions support
+ * ----------------------------------------------------------------
+ */
